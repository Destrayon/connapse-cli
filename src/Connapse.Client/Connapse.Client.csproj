<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Connapse REST API client, generated by Kiota from spec/openapi.json. Everything under Generated/
    is generator output: change the spec pin and run scripts/generate-client.sh, never edit it by hand.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Connapse.Client</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Generated code isn't held to this repo's documentation or nullable-reference rules. -->
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.1.2" />
  </ItemGroup>

</Project>
