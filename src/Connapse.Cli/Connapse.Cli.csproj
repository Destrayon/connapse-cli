<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="NuGet.Versioning" Version="7.3.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Connapse.Cli</RootNamespace>

    <!-- NuGet global tool: dotnet tool install -g Connapse.CLI -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>connapse</ToolCommandName>
    <PackageId>Connapse.CLI</PackageId>
    <Version>0.4.2</Version>
    <Authors>Connapse Contributors</Authors>
    <Description>CLI for Connapse — the AI knowledge management platform.</Description>
    <PackageProjectUrl>https://github.com/Destrayon/connapse-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Destrayon/connapse-cli</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <AssemblyName>connapse</AssemblyName>

    <!-- Self-contained single-file publish (used by release.yml).
         Trimming is disabled because System.Text.Json reflection-based
         deserialization of our DTO records (positional records with
         trim-invisible constructors) breaks under trim. The cost is
         ~3x larger binaries; the benefit is reliable JSON round-trips
         without having to annotate every model type. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!--
    (Trimming disabled in 0.4.1 — see comment on PublishTrimmed above.
    The former trimmer-roots.xml descriptor is gone.)
  -->

</Project>
